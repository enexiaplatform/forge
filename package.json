{
  "name": "forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Forge — Commitment & Outcome Execution Infrastructure in the Helm ecosystem.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test \"packages/*/test/*.test.mjs\" \"server/test/*.test.mjs\"",
    "test:integration": "node --import ./integration/support/register.mjs --test \"integration/*.test.mjs\"",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:loop": "node scripts/verify-loop.mjs",
    "verify": "npm run verify:boundaries && npm run verify:schema && npm run verify:loop",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run verify",
    "eval:extraction": "node server/eval/extraction-eval.mjs",
    "eval:extraction:live": "node server/eval/extraction-eval.mjs --live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@forge/demo": "0.1.0",
    "@forge/fabric": "0.1.0",
    "@forge/kernel": "0.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
