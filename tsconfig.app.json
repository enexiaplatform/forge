{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@forge/kernel": ["./packages/kernel/src/index.ts"],
      "@forge/kernel/postgres": ["./packages/kernel/src/postgres.ts"],
      "@forge/fabric": ["./packages/fabric/src/index.ts"],
      "@forge/demo": ["./packages/demo/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src"]
}
